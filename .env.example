# .env.example — Copy this file to .env and fill in real values.
# DO NOT commit .env to version control (it is in .gitignore)!
# This file (.env.example) IS committed as a template.

# ── Neo4j Connection ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# BUG-02 Fix: Required — no default. Set a strong password!
# Do NOT use "password" in production.
NEO4J_PASSWORD=change-me-in-production

# ── Redis Cache ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS Origins (comma-separated, no spaces) ────────────────────────────
# BUG-01 Fix: Set this explicitly. Never use wildcard * with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── API Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Etherscan API ────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_api_key_here

# ── Optional: Weights & Biases Experiment Tracking ───────────────────────
# WANDB_API_KEY=your-wandb-api-key
# WANDB_PROJECT=on-chain-fraud-detection
