# .env.example — copy to .env and fill in values
# See system_design.md §9 for full reference

# FastAPI
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME
REDIS_URL=redis://redis:6379
ETHERSCAN_API_KEY=CHANGE_ME
MODEL_CHECKPOINT=checkpoints/best_model.pt
MODEL_CONFIG=checkpoints/model_config.json
API_KEY=CHANGE_ME_32_CHAR_RANDOM

# Node.js BFF (frontend/server/.env)
FASTAPI_URL=http://fastapi:8000
FASTAPI_API_KEY=CHANGE_ME_32_CHAR_RANDOM
JWT_SECRET=CHANGE_ME_256_BIT_RANDOM
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
NODE_ENV=production
PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ADMIN_RATE_LIMIT_MAX=20
